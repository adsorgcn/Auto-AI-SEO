#, php-format
msgid "%1$d rewritten — %2$s"
msgstr "%1$d 个重写——%2$s"

#. translators: %s: file path
#: admin/class-aaseo-admin.php:403
#, php-format
msgid "A real robots.txt file exists at %s. The web server serves that file directly, so no WordPress rules (from this or any plugin) apply. Edit or remove the file yourself — this plugin will never touch it."
msgstr "%s 处存在物理 robots.txt 文件。Web 服务器会直接读取该文件,WordPress 的任何规则(本插件或其他插件的)都不会生效。请自行编辑或删除该文件——本插件绝不会碰它。"

#: admin/class-aaseo-admin.php:410
msgid "robots.txt rules"
msgstr "robots.txt 规则"

#: admin/class-aaseo-admin.php:411
#: admin/class-aaseo-admin.php:413
msgid "on"
msgstr "开"

#: admin/class-aaseo-admin.php:411
#: admin/class-aaseo-admin.php:413
msgid "off"
msgstr "关"

#: admin/class-aaseo-admin.php:412
msgid "noindex headers"
msgstr "noindex 响应头"

#: admin/class-aaseo-admin.php:415
msgid "noindex paths"
msgstr "noindex 路径"

#: admin/class-aaseo-admin.php:418
msgid "Registered by other plugins via the aaseo_noindex_paths filter. These stay crawlable on purpose: crawlers must be able to fetch a URL to see its noindex."
msgstr "由其他插件通过 aaseo_noindex_paths 过滤器注册。这些路径特意保持可抓取:爬虫必须能访问 URL,才能看到它的 noindex。"

#: admin/class-aaseo-admin.php:420
msgid "none registered"
msgstr "无注册项"

#: admin/class-aaseo-admin.php:425
msgid "dropped rules"
msgstr "被拒绝的规则"

#: admin/class-aaseo-admin.php:427
msgid "These Disallow rules were refused: they overlap a noindex path, and blocking crawl there would hide the noindex from crawlers (or the 50-rule cap was hit)."
msgstr "这些 Disallow 规则被拒绝:它们与 noindex 路径重叠,屏蔽抓取会让爬虫看不到 noindex(或已达 50 条规则上限)。"

#: admin/class-aaseo-admin.php:431
msgid "appended block"
msgstr "追加的规则块"

#: admin/class-aaseo-admin.php:435
msgid "nothing (module disabled or no rules)"
msgstr "无(模块已关闭或没有规则)"

#. translators: %s: robots.txt URL
#: admin/class-aaseo-admin.php:439
#, php-format
msgid "Live file: %s"
msgstr "线上文件:%s"

